# Supabase (public — used by forms)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Admin portal (server-only — never prefix these with NEXT_PUBLIC_)
# Supabase → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=
# Admin logins (email + password) live in the admin_users table in Supabase — not here.
# Optional: comma-separated emails that are always treated as OWNERS.
ADMIN_EMAILS=
# Long random string used to sign admin sessions (e.g. `openssl rand -hex 32`)
ADMIN_JWT_SECRET=

# Optional: sender for certificate emails (domain must be verified in Resend)
# CERTIFICATE_FROM_EMAIL=IEEE CIS CUSB <certificates@ieeeciscusb.site>
